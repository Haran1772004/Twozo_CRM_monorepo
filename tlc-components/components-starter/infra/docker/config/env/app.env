# ══════════════════════════════════════════════════════════════════════════════
#  APP.ENV — All environment variables for every backend service
#  (iam-server, file-server, email-server, social, crm-server)
#
#  Each Spring Boot service picks up only the properties it recognises;
#  the rest are silently ignored — so one file is safe for all images.
# ══════════════════════════════════════════════════════════════════════════════

# ── Spring Profile & Application Domains ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=container
TWOZO_WORK_DIR=twozo
LOCAL_DOMAIN=http://localhost:8080
CLIENT_LOCAL_DOMAIN=http://localhost:3000

# ── Key Vault ────────────────────────────────────────────────────────────────
SPRING_CLOUD_AZURE_KEYVAULT_SECRET_PROPERTY_SOURCE_ENABLED=false

# ── Database Configuration ───────────────────────────────────────────────────
# NOTE: POSTGRES_* vars are read by the postgres container.
#       TLC-CONFIG-DATABASE-* vars are read by Spring Boot app services.
#       Both must stay in sync — update values in both places together.
POSTGRES_DB=TLC
TLC-CONFIG-DATABASE-OLTP-NAME=TLC

POSTGRES_USER=postgres
TLC-CONFIG-DATABASE-OLTP-USERNAME=postgres

POSTGRES_PASSWORD=Twozo@123
TLC-CONFIG-DATABASE-OLTP-PASSWORD=Twozo@123

TLC-CONFIG-DATABASE-OLTP-SERVER=postgres:5432
TLC_CONFIG_DATABASE_OLTP_DEVELOPMENTMODEENABLED=true

# Used by Kafka Connect CDC connector (without port)
TLC-CONFIG-DATABASE-SERVER-WITHOUT-PORT=postgres
TLC-CONFIG-DATABASE-SERVER=postgres:5432
TLC-CONFIG-DATABASE-PORT=5432
TLC-CONFIG-DATABASE-USERNAME=postgres
TLC-CONFIG-DATABASE-PASSWORD=Twozo@123
TLC-CONFIG-DATABASE-NAME=TLC
TLC_CONFIG_DATABASE_RESOURCE_SERVERMODE=container
TLC_CONFIG_DATABASE_RESOURCE_HOME=/opt/data
TLC_CONFIG_DATABASE_RESOURCE_STORETYPE=local

# ── Cache Configuration ─────────────────────────────────────────────────────
TLC-CONFIG-CACHE-SERVER=redis:6379
TLC-CONFIG-CACHE-PASSWORD=Twozo@123
TLC_CONFIG_CACHE_TYPE=SINGLE
TLC_CONFIG_CACHE_SCHEME=redis
TLC_CONFIG_CACHE_TEST_ENABLED=true

# ── Zookeeper Configuration ─────────────────────────────────────────────────
TLC-CONFIG-ZOOKEEPER-SERVER=zookeeper:2181

# ── Storage - Azure Configuration ───────────────────────────────────────────
# NOTE: Hyphenated keys are read by Spring Boot apps.
#       Underscore keys (ACCOUNTNAME, ACCOUNTKEY, AZURITE_ENDPOINT) are also
#       needed by init-azurite-containers.sh (shell can't read hyphenated vars).
TLC-CONFIG-STORAGE-AZURE-ACCOUNTNAME=crmuistorage49933
TLC-CONFIG-STORAGE-AZURE-ACCOUNTKEY=${ACCOUNT_KEY}
TLC-CONFIG-STORAGE-AZURE-ENDPOINT=DefaultEndpointsProtocol=https;AccountName=crmuistorage49933;AccountKey=EP73eCSJAWbrIXitcCinEqmRl1D9O1tIAKniog3sQgsmYcEVOq/Av3XLyQemt3sLdgm1AdLg+0no+AStLcaheQ==;EndpointSuffix=core.windows.net
TLC-CONFIG-STORAGE-AZURE-AUTHTYPE=CONNECTION_STRING
TLC-CONFIG-STORAGE-AZURE-CONTAINERS-INDEX-0=twozo-crm-test-storage:GENERAL
TLC-CONFIG-STORAGE-AZURE-CONTAINERS-INDEX-1=twozo-crm-test-metadata:SCHEMA
TLC-CONFIG-STORAGE-AZURE-CONTAINERS-INDEX-2=twozo-crm-test-event-stream:EVENT_STREAM
TLC-CONFIG-STORAGE-AZURE-AZURITE-ENDPOINT=http://azurite:10000/devstoreaccount1
TLC_CONFIG_STORAGE_AZURE_AZURITE_ENABLED=false
TLC_CONFIG_STORAGE_AZURE_ACCOUNTNAME=devstoreaccount1
TLC_CONFIG_STORAGE_AZURE_ACCOUNTKEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
TLC_CONFIG_STORAGE_AZURE_AZURITE_ENDPOINT=http://azurite:10000/devstoreaccount1
TLC_CONFIG_STORAGE_AWS_AUTHMETHOD=CUSTOM
TLC_CONFIG_STORAGE_CLIENT=azure

# ── Storage - AWS Configuration ─────────────────────────────────────────────
TLC-CONFIG-STORAGE-AWS-SERVER=15.207.192.7:7003
TLC-CONFIG-STORAGE-AWS-ACCESSKEY=dummyAccessKey
TLC-CONFIG-STORAGE-AWS-SECRETKEY=dummySecretKey
TLC-CONFIG-STORAGE-AWS-BUCKET=twozo-dev
TLC-CONFIG-STORAGE-AWS-REGION=ap-south-1

# ── Queue - Kafka Configuration ─────────────────────────────────────────────
TLC-CONFIG-QUEUE-PROVIDER=SelfManagedKafka
TLC-CONFIG-QUEUE-KAFKA-SELFMANAGED-SERVER=PLAINTEXT://kafka:9092
TLC-CONFIG-QUEUE-KAFKA-MANAGED-SERVER=
TLC_CONFIG_QUEUE_KAFKA_MANAGED_SECURITY_PROTOCOL=SASL_SSL
TLC_CONFIG_QUEUE_KAFKA_MANAGED_PROVIDER=azure
TLC-CONFIG-QUEUE-KAFKA-MANAGED-AWS-SASL-MECHANISM=AWS_MSK_IAM
TLC-CONFIG-QUEUE-KAFKA-MANAGED-AWS-SASL-JAAS-CONFIG=software.amazon.msk.auth.iam.IAMLoginModule required;
TLC-CONFIG-QUEUE-KAFKA-MANAGED-AWS-SASL-CLIENT-CALLBACK-HANDLER-CLASS=software.amazon.msk.auth.iam.IAMClientCallbackHandler
TLC-CONFIG-QUEUE-KAFKA-MANAGED-AZURE-SASL-MECHANISM=OAUTHBEARER
TLC-CONFIG-QUEUE-KAFKA-MANAGED-AZURE-SASL-JAAS-CONFIG=org.apache.kafka.common.security.oauthbearer.OAuthBearerLoginModule required;
TLC-CONFIG-QUEUE-KAFKA-MANAGED-AZURE-SASL-LOGIN-CALLBACK-HANDLER-CLASS=com.tlc.queue.internal.kafka.security.handler.AzureAuthCallbackHandler
TLC-CONFIG-QUEUE-KAFKA-MANAGED-AZURE-SASL-OAUTHBEARER-TOKEN-ENDPOINT-URL=https://local-test.servicebus.windows.net/.default
TLC-CONFIG-QUEUE-KAFKA-MANAGED-AZURE-SASL-AUTH-CALLBACK-SCOPE=https://local-test.servicebus.windows.net/.default

# Bootstrap server used by Kafka Connect CDC schema history
TLC-CONFIG-KAFKA-SERVER=kafka:9092

# Kafka Connect REST API URL (used for CDC connector registration)
TLC-CONFIG-KAKFA-CONNECT-URL=http://kafka-connect:8083/connectors/

