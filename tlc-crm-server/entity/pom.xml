<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <artifactId>crm-server</artifactId>
        <groupId>com.tlc.crm</groupId>
        <version>9.35.0-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>entity</artifactId>
    <version>6.29.0-SNAPSHOT</version>
    <packaging>bundle</packaging>

    <dependencies>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>commons</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>sql-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>validator</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>common</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>i18n</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>cache</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>attachment</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>search</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>queue</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>scheduler</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>cluster</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>notification</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>exchange-rate</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>icon</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>l10n</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>fields</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>app-notification</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>security</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.file</groupId>
            <artifactId>file-client</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.email</groupId>
            <artifactId>email-client</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>oltp</artifactId>
            <scope>compile</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.karaf.tooling</groupId>
                <artifactId>karaf-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Bundle-Activator>com.tlc.crm.entity.Activator</Bundle-Activator>
                        <Export-Package>com.tlc.crm.entity.*</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>