def territoryIds = params.territoryIds;
def ownerId = params.ownerId;
def sourceCompany = params._source.company;
def sourceContact = params._source.contact;
def sourceDeal = params._source.deal;
def territory = "territory";
def isContactTerritorial = territory.equals(params.contactPermission);
def isCompanyTerritorial = territory.equals(params.companyPermission);
def isContactFollower = params.isContactFollower;
def isCompanyFollower = params.isCompanyFollower;
def isDealFollower = params.isDealFollower;
Map results = new HashMap();

if (null != sourceCompany) {
  def followers = sourceCompany.followerIds;

  if ((isCompanyTerritorial && territoryIds.contains(sourceCompany.territoryId)) || ownerId == sourceCompany.ownerId ||
      (isCompanyFollower && followers != null && followers.contains(ownerId))) {
    Map companyFields = new HashMap();

    companyFields.put("name", sourceCompany.name);
    companyFields.put("website", sourceCompany.website);
    companyFields.put("address", sourceCompany.address);
    companyFields.put("id", sourceCompany.id);
    results.put("company", companyFields);
  }
}

if (null != sourceContact && !sourceContact.isEmpty()) {
  def contactFollowers = sourceContact.followerIds;

  if ((isContactTerritorial &&
       territoryIds.contains(sourceContact.territoryId)) ||
      ownerId == sourceContact.ownerId ||
      (isContactFollower && contactFollowers != null &&
       contactFollowers.contains(ownerId))) {
    Map contactFields = new HashMap();
    def contactCompany = sourceContact.company;

    contactFields.put("name", sourceContact.name);
    contactFields.put("emails", sourceContact.emails);
    contactFields.put("phones", sourceContact.phones);
    contactFields.put("linkedin", sourceContact.linkedin);
    contactFields.put("facebook", sourceContact.facebook);
    contactFields.put("id", sourceContact.id);

    if (null != contactCompany) {
      def companyFollowers = contactCompany.followerIds;

      if ((isCompanyTerritorial &&
           territoryIds.contains(contactCompany.territoryId)) ||
          ownerId == contactCompany.ownerId ||
          (isCompanyFollower && companyFollowers != null &&
           companyFollowers.contains(ownerId))) {
        Map contactCompanyMap = new HashMap();

        contactCompanyMap.put("name", contactCompany.name);
        contactCompanyMap.put("id", contactCompany.id);
        contactFields.put("company", contactCompanyMap);
      }
    }
    results.put("contact", contactFields);
  }
}

if (null != sourceDeal) {
  def followers = sourceDeal.followerIds;

  if ((territory.equals(params.dealPermission) && territoryIds.contains(sourceDeal.territoryId)) ||ownerId == sourceDeal.ownerId ||
      (isDealFollower && followers != null && followers.contains(ownerId))) {
    Map dealFields = new HashMap();
    def dealContact = sourceDeal.contact;
    def dealCompany = sourceDeal.company;

    dealFields.put("name", sourceDeal.name);
    dealFields.put("dealState", sourceDeal.dealState);
    dealFields.put("expectedCloseDate", sourceDeal.expectedCloseDate);
    dealFields.put("totalProductCount", sourceDeal.totalProductCount);
    dealFields.put("pipeline", sourceDeal.pipeline);
    dealFields.put("dealValue", sourceDeal.dealValue);
    dealFields.put("pipelineStage", sourceDeal.pipelineStage);
    dealFields.put("id", sourceDeal.id);

    if (null != dealContact && !dealContact.isEmpty()) {
      def contactFollowers = dealContact.followerIds;

      if ((isContactTerritorial && territoryIds.contains(dealContact.territoryId)) || ownerId == dealContact.ownerId ||
          (isContactFollower && contactFollowers != null && contactFollowers.contains(ownerId))) {
        Map dealContactMap = new HashMap();

        dealContactMap.put("name", dealContact.name);
        dealContactMap.put("id", dealContact.id);
        dealFields.put("contact", dealContactMap);
      }
    }

    if (null != dealCompany) {
      def companyFollowers = dealCompany.followerIds;

      if ((isCompanyTerritorial && territoryIds.contains(dealCompany.territoryId)) || ownerId == dealCompany.ownerId ||
          (isCompanyFollower && companyFollowers != null && companyFollowers.contains(ownerId))) {
        Map dealCompanyMap = new HashMap();

        dealCompanyMap.put("name", dealCompany.name);
        dealCompanyMap.put("id", dealCompany.id);
        dealFields.put("company", dealCompanyMap);
      }
    }
    results.put("deal", dealFields);
  }
}

if (results.isEmpty()) {
  return null;
} else {
  return results;
}

