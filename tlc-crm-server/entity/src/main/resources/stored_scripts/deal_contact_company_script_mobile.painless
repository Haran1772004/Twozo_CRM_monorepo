def territoryIds = params.territoryIds;
def ownerId = params.ownerId;
Map results = new HashMap();
def sourceContact = params._source.contact;
def sourceCompany = params._source.company;
def territory = "territory";
def isCompanyTerritorial = territory.equals(params.companyPermission);
def isContactFollower = params.isContactFollower;
def isCompanyFollower = params.isCompanyFollower;

if (null != sourceContact) {
  def contactFollowers = sourceContact.followerIds;

  if ((territory.equals(params.contactPermission) && territoryIds.contains(sourceContact.territoryId)) ||
      ownerId == sourceContact.ownerId || (isContactFollower && null != contactFollowers && contactFollowers.contains(ownerId))) {
    Map contactFields = new HashMap();
    def contactCompany = sourceContact.company;

    contactFields.put("name", sourceContact.name);
    contactFields.put("primaryEmail", sourceContact.primaryEmail);
    contactFields.put("id", sourceContact.id);
    results.put("contact", contactFields);
  }
}

if (null != sourceCompany) {
  def companyFollowers = sourceCompany.followerIds;

  if ((isCompanyTerritorial && territoryIds.contains(sourceCompany.territoryId)) ||
      ownerId == sourceCompany.ownerId || (isCompanyFollower && null != companyFollowers && companyFollowers.contains(ownerId))) {
    Map companyFields = new HashMap();

    companyFields.put("name", sourceCompany.name);
    companyFields.put("id", sourceCompany.id);
    results.put("company", companyFields);
  }
}

if (results.isEmpty()) {
  return null;
} else {
  return results;
}

