<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>crm-server</artifactId>
        <groupId>com.tlc.crm</groupId>
        <version>9.35.0-SNAPSHOT</version>
    </parent>

    <packaging>bundle</packaging>
    <version>1.13.0-SNAPSHOT</version>
    <artifactId>messenger</artifactId>

    <dependencies>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>commons</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>sql-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>validator</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>i18n</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>cache</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>scheduler</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>notification</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>attachment</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>common</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>security</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>entity</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tlc.crm</groupId>
            <artifactId>icon</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc.social</groupId>
            <artifactId>social-client</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>sync-service-oauth</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>oltp</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>

        <plugins>
            <plugin>
                <groupId>org.apache.karaf.tooling</groupId>
                <artifactId>karaf-maven-plugin</artifactId>
                <version>4.4.1</version>
            </plugin>

            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Bundle-Activator>com.tlc.crm.messenger.MessengerActivator</Bundle-Activator>
                        <Export-Package>com.tlc.crm.messenger.*</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>

    </build>

</project>