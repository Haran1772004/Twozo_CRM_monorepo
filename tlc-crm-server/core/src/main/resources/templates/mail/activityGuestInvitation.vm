
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Activity guest invitation</title>
  </head>
  <body>
  #set($model = $template.get("model"))
  #set($activity = $model.getActivity())
  #set($title = $activity.getTitle())
  #set($dateFormat = "dd MMM yyyy, hh:mm a")
  #set($dateTool = $date)
  #set($startTime = $dateTool.format($dateFormat, $activity.getStartTime().getTimeStamp()).replace("am", "AM").replace("pm", "PM"))
  #set($endTime = $dateTool.format($dateFormat, $activity.getEndTime().getTimeStamp()).replace("am", "AM").replace("pm", "PM"))

     #set($usersList = $template.getAll("users"))
       #set($isUsersListNotEmpty = $usersList && !$usersList.isEmpty())
           #if($isUsersListNotEmpty)
            #foreach($user in $usersList)

           #if($user.id().equals($activity.getCreatorId()))
              #set($userFullName = $user.getFullName())
           #end
        #end
      #end
    <div data-info-group="subject" style="display: none">Invitation: $title @ ($startTime - $endTime)</div>

    <div style="margin: 0 auto; background: #fafafa; padding: 5% 10%">
      <div>
        <div
          style="
            background: white;
            border-radius: 8px;
            border: 1px rgba(0, 0, 0, 0.1) solid;
            overflow: auto;
            padding: 40px;
          "
        >
          <div>
            <img
              width="107px"
              height="33px"
              src="https://twozo.io/_next/image?url=%2Fimages%2Flogo%2Ftwozo-full-logo.png&w=256&q=75"
              alt="twozo"
            />
          </div>

          <div style="padding-top: 32px">
            <div>
              <p
                style="
                  margin: 0px;
                  font-size: 18px;
                  font-weight: 600;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                "
              >
                Invitation
              </p>

              <p
                style="
                  margin: 0px;
                  padding-top: 9px;
                  font-size: 14px;
                  font-weight: 400;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  color: #00000099;
                "
              >
                <span style="color: black">$userFullName</span>
                invited you to
                <span style="color: black">New Event.</span>
              </p>
            </div>

            <div style="padding-top: 24px">
              <table style="border-spacing: 0px 12px">
                <tr
                  style="
                    font-family: Verdana, Geneva, Tahoma, sans-serif;
                    font-size: 14px;
                    font-weight: 400;
                  "
                >
                  <td style="width: 110px; color: #00000099">Event Name :</td>
                  <td>$title</td>
                </tr>

                <tr
                  style="
                    font-family: Verdana, Geneva, Tahoma, sans-serif;
                    font-size: 14px;
                    font-weight: 400;
                  "
                >
                  <td
                    style="width: 110px; color: #00000099; vertical-align: top"
                  >
                    Time :
                  </td>
                  <td>$startTime - $endTime</td>
                </tr>

                #set($location = $activity.getLocation())
                #if($location)
                <tr
                  style="
                    font-family: Verdana, Geneva, Tahoma, sans-serif;
                    font-size: 14px;
                    font-weight: 400;
                  "
                >
                  <td
                    style="width: 110px; color: #00000099; vertical-align: top"
                  >
                    Location :
                  </td>
                  <td>
                    $location
                  </td>
                </tr>
                #end

                #set($guests = $model.getActivityGuests())
                #if($guests && !$guests.isEmpty())
                #set($totalGuests = $guests.size())
                <tr
                  style="
                    font-family: Verdana, Geneva, Tahoma, sans-serif;
                    font-size: 14px;
                    font-weight: 400;
                  "
                >
                  <td
                    style="width: 110px; color: #00000099; vertical-align: top"
                  >
                    Guest :
                  </td>
                  <td>
                    #set($index = 0)
                    #foreach($activityGuest in $guests)
                    #set($contact = $activityGuest.getContact())
                     #if($contact)
                       #set($fullName = $contact.getFullName())
                     #end
                   #set($email = $activityGuest.getEmail())
                   #if($email)
                      #set($emailAddress = $email.getValue())
                         #end
                      <span>
                      $fullName  -
                      <a
                      href="mailto:$emailAddress"
                      target="_blank"
                      style= "color: #33bc7e;cursor: pointer;text-decoration: none;">$emailAddress#if($index < $totalGuests - 1),#end</a>
                      </span>

                   #set($index = $index + 1)
                   #end
                  </td>
                </tr>
                #end

               #if($activity.getDescription())
                <tr
                  style="
                    font-family: Verdana, Geneva, Tahoma, sans-serif;
                    font-size: 14px;
                    font-weight: 400;
                  "
                >
                  <td
                    style="width: 110px; color: #00000099; vertical-align: top"
                  >
                    Description :
                  </td>

                  <td>
                    $activity.getDescription()
                  </td>
                </tr>
                #end
              </table>
            </div>

            <div style="padding-top: 32px">
              <p
                style="
                  margin: 0px;
                  font-size: 14px;
                  font-weight: 400;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                "
              >
                Cheers,
              </p>
              <p
                style="
                  margin: 0px;
                  font-size: 14px;
                  font-weight: 600;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  padding-top: 4px;
                "
              >
                Team Twozo
              </p>
            </div>
          </div>
        </div>

        <div style="padding-top: 16px; text-align: center">
          <div style="text-align: center">
            <div>
              <img
                width="72px"
                height="22px"
                style="margin-right: 12px"
                src="https://ci3.googleusercontent.com/meips/ADKq_NaXM9lCOs5luvUcsKwYTE4a39T_j1ruuTAj8HA3Qy8qB1bdzlLyIO7AHV_2K__Ot03VQ3EH1vuUB1Mu4qt5BUWTutbWF1RsGsPe3yntKkeEGmn6iw=s0-d-e1-ft#https://ind-assets.freshsales.io/assets/images/google-play.png"
                alt="google-play"
              />

              <img
                width="72px"
                height="22px"
                style="margin-left: 12px"
                src="https://ci3.googleusercontent.com/meips/ADKq_NYiX6-9q45vsuMEOkPWau7MEr-X5uNrY1gMEsfkpicybI2bRIGTjDMrYhP1Bb6j4v5dNNUwVTT-mPj1IC6Zw-0IN2YHoEVW5WJE2TyQJgp2vRQlQ9vHvok=s0-d-e1-ft#https://ind-assets.freshsales.io/assets/images/apple-app-store.png"
                alt="apple-app-store"
              />
            </div>

            <div style="padding-top: 8px">
              <p
                style="
                  margin: 0px;
                  font-size: 10px;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  color: rgba(0, 0, 0, 0.6);
                "
              >
                Twozo Inc.
              </p>
            </div>

            <div style="text-align: center; padding-top: 8px; opacity: 0.6">
              <img
                width="20px"
                height="20px"
                src="https://cdn4.iconfinder.com/data/icons/iconsimple-logotypes/512/facebook-64.png"
                alt="facebook"
              />

              <img
                width="20px"
                height="20px"
                style="margin: 0px 32px"
                src="https://cdn3.iconfinder.com/data/icons/2018-social-media-logotypes/1000/2018_social_media_popular_app_logo_twitter-64.png"
                alt="twitter"
              />

              <img
                width="20px"
                height="20px"
                src="https://cdn2.iconfinder.com/data/icons/social-media-2102/100/social_media_circled_network-03-64.png"
                alt="linkedIn"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>