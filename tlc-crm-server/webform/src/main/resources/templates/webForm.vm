<!DOCTYPE html>
<html lang="en">
   <head>
      #set($model = $template.get("webForm")) #set($webForm = $model.getWebForm()) #set($formStyle = $webForm.getFormStyle()) #set($font = $webForm.getFormStyle().getFont()) #set($submitAction = $webForm.getSubmitAction())
      #set($formFieldProperties = $webForm.getFormFieldProperties())
      #set($isIFrame = $model.isIframe())
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Web form</title>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <!-- Font Family -->
      <link href="$font.getLink()" rel="stylesheet" />
      <style>
         :root {
         #set($fieldStyle = $webForm.getFieldStyle())
         #set($submitButtonStyle = $webForm.getSubmitButtonStyle())
         /* font family */
         --font-family: $font.getName();
         /* form */
         --form-bg-color: $formStyle.getBackgroundColor();
         --form-alignment: $formStyle.getAlignment().getName();
         --header-color: $formStyle.getHeaderTextColor();
         --header-font-size: $formStyle.getHeaderFontSize()px;
         --sub-header-color: $formStyle.getSubHeaderTextColor();
         --sub-header-font-size: $formStyle.getSubHeaderFontSize()px;
         --sub-text-font-size: $formStyle.getTextFontSize()px;
         --sub-text-color: $formStyle.getTextColor();
         --description-color: $formStyle.getDescriptionTextColor();
         --description-font-size: $formStyle.getDescriptionFontSize()px;
         --text-color: $formStyle.getTextColor();
         --text-font-size: $formStyle.getTextFontSize()px;
         /* fields */
         --label-color: $fieldStyle.getLabelColor();
         --label-font-size: $fieldStyle.getLabelFontSize()px;
         --input-text-color: $fieldStyle.getInputTextColor();
         --input-text-font-size: $fieldStyle.getInputFontSize()px;
         --input-bg-color: $fieldStyle.getInputBackgroundColor();
         /* submit button */
         --submit-btn-bg-color: $submitButtonStyle.getBackgroundColor();
         --submit-btn-text-color: $submitButtonStyle.getTextColor();
         --submit-btn-alignment: $submitButtonStyle.getAlignment().getName();
         }
         * {
         margin: 0;
         padding: 0;
         box-sizing: border-box;
         }
         body {
         font-family: var(--font-family), sans-serif;
         }
         input:focus,
         select:focus {
         outline: none;
         border-color: transparent;
         box-shadow: none;
         }
         textarea:focus{
         outline: none;
         border-color: transparent;
         box-shadow: none;
         }

         input,
         option,
         select,
         .chip {
         font-family: var(--font-family), sans-serif;
         }
         textarea{
         font-family: var(--font-family), sans-serif;
         }
         .form-container {
         width: 100%;
         height: 100%;
         #if(!$isIFrame)
         display: flex;
         flex-direction: column;
         align-items: center;
         #end
         }
         .form {
         #if($isIFrame)
         width: 100% ;
         #else
         width: 450px ;
         #end
         height: 100%;
         display: flex;
         flex-direction: column;
         padding: 16px;
         #if(!$isIFrame)
         margin-top: 12px;
         border-radius: 8px;
         #end
         border: none;
         background-color: var(--form-bg-color);
         text-align: var(--form-alignment);
         }
         @media (max-width: 600px) {
         .form {
         #if(!$isIFrame)
         width: 100%;
         #end
         }
         .form-container {
         width: 100%;
         padding: 16px;
         }
         }
         .input-field {
         padding: 8px 8px 8px 0;
         }
         select option:hover {
         background-color: rgba(51, 188, 126, 0.24);
         }
         input[type="number"]::-webkit-inner-spin-button,
         input[type="number"]::-webkit-outer-spin-button {
         -webkit-appearance: none;
         margin: 0;
         }
         /* Date field style */
         input[type="date"] {
         padding-left: 40px;
         }
         .calendar-icon {
         position: absolute;
         padding: 10px;
         cursor: pointer;
         }
         .date-picker-field {
         position: relative;
         }
         input[type="date"]::-webkit-calendar-picker-indicator {
         opacity: 0;
         cursor: pointer;
         z-index: 3;
         }
         .form-title {
         font-size: var(--header-font-size);
         color: var(--header-color);
         padding-left: 8px;
         font-weight: 600;
         padding-bottom: 8px;
         white-space: normal;
         overflow-wrap: break-word;
         word-break: break-word;
         }
         .form-sub-title {
         padding: 8px;
         font-size: var(--sub-header-font-size);
         font-weight: 400;
         color: var(--sub-header-color);
         }
         .form-sub-text {
          font-size: var(--sub-text-font-size);
          font-weight: 400;
          color: var(--sub-text-color);
          padding: 8px;
          }
         .form-label {
         display: block;
         font-size: var(--label-font-size);
         color: var(--label-color);
         padding: 0 0 8px 8px;
         font-weight: 500;
         white-space: normal;
         overflow-wrap: break-word;
         }
         .form-input {
         width: 100%;
         color: var(--input-text-color);
         font-size: var(--input-text-font-size);
         font-weight: 400;
         min-height: 42px;
         padding: 8px 16px;
         background-color: var(--input-bg-color);
         border-radius: 8px;
         border: none;
         text-align: left;
         }
         select {
         min-height: 42px;
         padding: 8px 14px;
         background-color: var(--input-bg-color);
         border-radius: 8px;
         font-size: var(--label-font-size);
         }
         .select-option {
         display: flex;
         justify-content: space-between;
         align-items: start;
         padding: 4px 0;
         }
         .single-select {
         appearance: none;
         -webkit-appearance: none;
         -moz-appearance: none;
         background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
         background-position: right 12px center;
         background-repeat: no-repeat;
         background-size: 20px 20px;
         white-space: nowrap;
         text-overflow:ellipsis;
         overflow:hidden;
         padding-right:30px;
         }
         .multi-select {
         width: 100%;
         position: relative
         }
         .checkbox {
         width: 12px;
         height: 12px;
         border: 1.5px solid rgba(0, 0, 0, 1);
         margin-top: 4px;
         }
         .multi-select-option {
         font-size: var(--input-text-font-size);
         white-space: normal;
         overflow-wrap: break-word;
         word-break: break-word;
         padding-right: 16px;
         }
         .dropdown {
         width: 100%;
         position: relative;
         display: inline-block;
         border: "none";
         }
         .dropdown-content label {
         display: block;
         }
         .dropdown-content {
         display: none;
         position: absolute;
         background-color: #fff;
         width: 100%;
         margin-top: 2px;
         border-radius: 8px;
         padding: 8px;
         z-index: 1;
         min-height: 0px;
         max-height: 200px;
         overflow: auto;
         }
         .chip {
         display: inline-flex;
         align-items: center;
         justify-content: center;
         background-color: var(--form-bg-color);
         color: var(--input-text-color);
         padding: 3px 4px;
         border-radius: 8px;
         font-size: var(--input-text-font-size);
         font-weight: 500;
         gap: 4px;
         margin-right: 8px;
         margin-bottom: 2px
         }
         .chip-close {
         background: none;
         border: none;
         color: gray;
         cursor: pointer;
         padding: 0;
         width: 20px;
         height: 20px;
         border-radius: 50%;
         display: flex;
         justify-content: center;
         row-gap: 4px;
         font-size: 18px;
         }
         .chip-close:hover {
         background-color: rgba(0, 0, 0, 0.1);
         }
         .chip-span{
         max-width: 350px;
         overflow: hidden;
         text-overflow: ellipsis;
         }
         .placeholder-text {
         color: #999;
         }
         .submit-btn-container {
         width: 100%;
         padding: 16px 30px 0 8px;
         text-align: var(--submit-btn-alignment);
         }
         .submit-btn {
         min-height: 36px;
         font-size: 13px;
         font-weight: 600;
         padding: 10px 16px;
         border-radius: 8px;
         color: var(--submit-btn-text-color);
         background-color: var(--submit-btn-bg-color);
         border: none;
         cursor: pointer;
         white-space: normal;
         overflow-wrap: break-word;
         word-break: break-word;
         }
         .required-simple {
         color: red;
         visibility: visible;
         }
         /* thankyou message styles */
         .thank-you-sub-container {
         height: 90vh;
         width: 90vw;
         background-color: var(--form-bg-color);
         border-radius: 12px;
         padding: 40px;
         display: flex;
         justify-content: center;
         align-items: center;
         flex-direction: column;
         gap: 21px;
         max-width: 400px;
         margin-top: 30px;
         }
         .thank-you-container {
         width: 100%;
         height: 100%;
         display: flex;
         justify-content: center;
         align-items: center;
         flex-direction: column;
         }
         .form-description {
         padding: 8px;
         font-size: var(--description-font-size);
         font-weight: 400;
         color: var(--description-color);
         padding-left: 8px;
         opacity: 0.6;
         }
         .checkmark-circle {
         width: 211px;
         height: 143px;
         }
         .thank-you-text {
         font-size: 17px;
         color: rgba(0, 0, 0, 0.87);
         font-weight: 600;
         }
         .monetary-field {
         display: flex;
         align-items: center;
         }
         .monetary-select {
         width: 30%;
         border-radius: 0px 8px 8px 0px !important;
         margin-left: -10px !important;
         border-left: 1px solid rgba(0, 0, 0, 0.2) !important;
         appearance: none;
         -webkit-appearance: none;
         -moz-appearance: none;
         background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
         background-position: right 12px center;
         background-repeat: no-repeat;
         background-size: 20px 20px;
         }
          /* Validation error styles */
          .validation-error {
          color: red;
          font-size: 14px;
          margin-top: 5px;
          display: block;
          }
          /* Image element styles */
          .form-banner-image {
              width: var(--image-width, 100%);
              height: var(--image-height, auto);
              max-width: 100%;
              object-fit: fill;
              display: block;
              margin: 8px 8px 8px 0;
            }
          .input-field.store-type-IMAGE {
              max-width: 100%;
              max-height: 1024px;
              overflow: hidden;
              display: flex;
              justify-content: var(--image-align, flex-start);
          }
       </style>
   </head>
   <body>
      <!-- Form container -->
      <section class="form-container">
      <!-- Form -->
      <form class="form" id="web-form">
         <!-- Form title -->
         <p class="form-title">$webForm.getName()</p>
         <!-- Form description -->
         #set($description = $webForm.getDescription())
         #if($description)
         <p class="form-description">$description</p>
         #end
         <input type="hidden" id="id" value="$webForm.id()" />
         #foreach($formFieldProperty in $formFieldProperties) #set($fieldLabelName = $formFieldProperty.getLabel()) #set($storeElementType=$formFieldProperty.getName()) #if("ELEMENT" == $formFieldProperty.getType().name())
          #if($storeElementType == "Subheader")
          <p class="form-sub-title">$fieldLabelName</p>
          #elseif($storeElementType == "Image")
          <div class="input-field store-type-IMAGE">
             <img
             id="form-image-$formFieldProperty.id()"
             class="form-banner-image"
             />
          </div>
          #else
          <p class="form-sub-text">$fieldLabelName</p>
          #end
         #else #set($labelName = $fieldLabelName) #set($fieldPropertyId = $formFieldProperty.id()) #set($fieldId = $formFieldProperty.getFieldId()) #set($storeType = $formFieldProperty.getStoreType().getName()) #set($isRequired =
         $formFieldProperty.isRequired())
         <div class="input-field store-type-$storeType">
            <label class="form-label" for="$labelName">
            $labelName #if($isRequired)
            <span class="required-simple">*</span>
            #end
            </label>
            #if($storeType == "SINGLE_NUMBER")
            <input #if($isRequired) required #end id="$fieldPropertyId" oninput="handleNumberChange(event, '$fieldPropertyId')" name="$labelName" class="form-input" type="text" />
            #elseif($storeType == "DROPDOWN")
            <select #if($isRequired) required #end id="$fieldPropertyId" name="$labelName" class="form-input single-select">
            #set($options = $model.getOptionMap().get($fieldId))
            <option value="" disabled selected></option>
            #foreach($option in $options)
            <option value="$option.id()">$option.getOption()</option>
            #end
            </select>
            </select>
            #elseif($storeType == "EMAIL" || $storeType == "EMAILS")
            <input #if($isRequired) required #end
            id="$fieldPropertyId"
            name="$labelName"
            class="form-input"
            oninput="handleEmailInputChange(event, '$fieldPropertyId')"
            type="text" />
            #elseif($storeType == "PHONE" || $storeType == "PHONES")
            <input #if($isRequired) required #end
            id="$fieldPropertyId"
            name="$labelName"
            onkeypress="return /[0-9+\-() ]/.test(event.key)"
            class="form-input"
            oninput="handlePhoneInputChange(event, '$fieldPropertyId')"
            type="text" />
            #elseif($storeType == "MULTI_SELECT")
            <div class="multi-select">
               <button type="button" id="$fieldPropertyId" class="form-input multi-select" onclick="toggleMultiselectDropdown(event, '$fieldId', '$fieldPropertyId')"></button>
               <div id="$fieldId" class="dropdown-content">
                  #set($options = $model.getOptionMap().get($fieldId)) #if($options && $options.size() > 0) #foreach($option in $options)
                  <label>
                     <div class="select-option">
                        <p class="multi-select-option">$option.option</p>
                        <input id="$fieldPropertyId" type="checkbox" class="checkbox" value="$option.id()" />
                     </div>
                  </label>
                  #end #else
                  <p>No options available.</p>
                  #end
               </div>
            </div>
            #elseif($storeType == "MONETARY")
            <div class="monetary-field">
               <input #if($isRequired) required #end id="$fieldPropertyId" name="$labelName" type="number" class="form-input" min="0" step="0.01" />
               <select required id="${fieldPropertyId}-currency" name="${labelName}-currency" class="form-input monetary-select">
                  #set($currencyDataList = $model.getCurrencyDataList()) #foreach($currencyData in $currencyDataList) #set($currency = $currencyData.currency())
                  <option value="$currency.getId()">$currency.getCode()</option>
                  #end
               </select>
            </div>
            #elseif($storeType == "DATE")
            <div class="date-picker-field">
               <div class="calendar-icon" onclick="openDatePicker('$fieldPropertyId')">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                     <g opacity="0.6">
                        <path d="M6.66602 1.66699V3.33366" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M13.334 1.66699V3.33366" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2.91602 7.5752H17.0827" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path
                           d="M17.5 14.167C17.5 16.667 16.25 18.3337 13.3333 18.3337H6.66667C3.75 18.3337 2.5 16.667 2.5 14.167V7.08366C2.5 4.58366 3.75 2.91699 6.66667 2.91699H13.3333C16.25 2.91699 17.5 4.58366 17.5 7.08366V14.167Z"
                           stroke="black"
                           stroke-width="1.5"
                           stroke-linecap="round"
                           stroke-linejoin="round"
                           />
                        <path d="M13.0781 11.417H13.0856" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M9.99609 11.417H10.0036" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M9.99609 14.75H10.0036" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M6.91211 11.417H6.91959" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M6.91211 14.75H6.91959" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                     </g>
                  </svg>
               </div>
               <input #if($isRequired) required #end id="$fieldPropertyId" name="$labelName" type="date" class="form-input" />
            </div>
            #elseif($storeType == "SINGLE_STRING")
            <input #if($isRequired) required #end
            id="$fieldPropertyId"
            name="$labelName"
            class="form-input"
            oninput="handleTextInputChange(event, '$fieldPropertyId')"
            type="text" />
            #elseif($storeType == "TEXT")
            <textarea #if($isRequired) required #end style="resize:none;" id="$fieldPropertyId" rows="3" name="$labelName"
            class="form-input" oninput="handleTextAreaInputChange(event, '$fieldPropertyId')"></textarea>
            #else
            <input #if($isRequired) required #end id="$fieldPropertyId" name="$labelName" class="form-input" type="text" />
            #end
         </div>
         #end #end
         <!-- Form submit button -->
         <div class="submit-btn-container">
            <button class="submit-btn" type="submit">$webForm.getSubmitButtonName()</button>
         </div>
      </form>
      <!-- Thank You Message -->
      <div id="thank-you" style="display: none;">
         <div class="thank-you-container">
            <div class="thank-you-sub-container">
               <div class="checkmark-circle">
                  <svg width="211" height="143" viewBox="0 0 211 143" fill="none" xmlns="http://www.w3.org/2000/svg">
