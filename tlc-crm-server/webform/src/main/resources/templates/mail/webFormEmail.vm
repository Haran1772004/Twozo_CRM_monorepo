<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <title>Export</title>
   </head>
   <body>
      #set($model = $template.get("model"))
      #set($webForm = $model.getWebForm())
      #set($entity = $model.getEntity())
      #set($dateTool = $date)
      #set($entityType = $entity.getEntityType())
      #set($type = $entityType.toLowerCase())
      #if ($type == "contact")
      #set($contact = $entity)
      #elseif ($type == "deal")
      #set($deal = $entity)
      #set($contact = $deal.getPrimaryContact())
      #end
      #set($contactFullName = $contact.getFullName())
      <div data-info-group="subject" style="display: none">New Web Forms deal!</div>
      <div style="margin: 0 auto; background: #fafafa; padding: 5% 10%">
         <div>
            <div
               style="
               background: white;
               border-radius: 8px;
               border: 1px rgba(0, 0, 0, 0.1) solid;
               overflow: auto;
               padding: 40px;
               "
               >
               <div>
                  <img
                     width="107px"
                     height="33px"
                     src="https://www.twozo.io/_next/image?url=%2Fimages%2Flogo%2Ftwozo-full-logo.png&w=256&q=75"
                     alt="twozo"
                     />
               </div>
               <div style="padding-top: 32px">
                  <div>
                     <p
                        style="
                        margin: 0px;
                        font-size: 18px;
                        font-weight: 700;
                        font-family: Verdana, Geneva, Tahoma, sans-serif;
                        "
                        >
                        New Web Forms deal!
                     </p>
                     <p
                        style="
                        margin: 0px;
                        padding-top: 9px;
                        font-size: 14px;
                        font-weight: 400;
                        font-family: Verdana, Geneva, Tahoma, sans-serif;
                        color: rgba(0, 0, 0, 0.6);
                        "
                        >
                        <span
                           style="
                           font-size: 14px;
                           font-weight: 400;
                           color: #000;
                           "
                           >
                        $contactFullName
                        </span>
                        has submitted the requested details through the web form:
                        <span
                           style="
                           font-size: 14px;
                           font-weight: 400;
                           color: #000;
                           "
                           >
                        $webForm.getName()
                        </span>
                     </p>
                     <div style="padding-top: 16px">
                        <a href="$model.getDomain()" target="_blank">
                        <button
                           style="
                           font-size: 13px;
                           font-family: Verdana, Geneva, Tahoma, sans-serif;
                           font-weight: 600;
                           color: #fff;
                           background-color: #33bc7e;
                           border-radius: 8px;
                           padding: 8px 16px;
                           border: none;
                           cursor: pointer;
                           "
                           >
                        Open in Twozo
                        </button>
                        </a>
                     </div>
                     <p
                        style="
                        margin: 0px;
                        padding-top: 16px;
                        font-size: 14px;
                        font-weight: 400;
                        font-family: Verdana, Geneva, Tahoma, sans-serif;
                        "
                        >
                        Summary
                     </p>
                     <div style="padding-top: 24px">
                        <table>
                           #if ($deal)
                           <tr
                              style="
                              font-family: Verdana, Geneva, Tahoma, sans-serif;
                              font-size: 14px;
                              font-weight: 400;
                              "
                              >
                              <td
                                 style="
                                 width: 130px;
                                 color: rgb(0, 0, 0, 0.6);
                                 align-content: baseline;
                                 padding-bottom: 12px;
                                 "
                                 >
                                 Deal Name :
                              </td>
                              <td style="padding-bottom: 12px">
                                 $deal.getTitle()
                              </td>
                           </tr>
                           #end
                           <tr
                              style="
                              font-family: Verdana, Geneva, Tahoma, sans-serif;
                              font-size: 14px;
                              font-weight: 400;
                              "
                              >
                              <td
                                 style="
                                 width: 130px;
                                 color: rgb(0, 0, 0, 0.6);
                                 align-content: baseline;
                                 padding-bottom: 12px;
                                 "
                                 >
                                 Contact Name :
                              </td>
                              <td style="padding-bottom: 12px">
                                 $contactFullName
                              </td>
                           </tr>
                           #set($company = $contact.getCompany())
                           #if ($company)
                           <tr
                              style="
                              font-family: Verdana, Geneva, Tahoma, sans-serif;
                              font-size: 14px;
                              font-weight: 400;
                              "
                              >
                              <td
                                 style="
                                 width: 130px;
                                 color: rgb(0, 0, 0, 0.6);
                                 align-content: baseline;
                                 padding-bottom: 12px;
                                 "
                                 >
                                 Company Name :
                              </td>
                              <td style="padding-bottom: 12px">
                                 $company.getName()
                              </td>
                           </tr>
                           #end
                           #set($email = $contact.getPrimaryEmail())
                           #if ($email)
                           <tr
                              style="
                              font-family: Verdana, Geneva, Tahoma, sans-serif;
                              font-size: 14px;
                              font-weight: 400;
                              "
                              >
                              <td
                                 style="
                                 width: 130px;
                                 color: rgb(0, 0, 0, 0.6);
                                 align-content: baseline;
                                 padding-bottom: 12px;
                                 "
                                 >
                                 Emails:
                              </td>
                              <td style="padding-bottom: 12px">
                                 <a
                                    href="mailto:$email.getValue()"
                                    style="
                                    color: #33bc7e;
                                    cursor: pointer;
                                    text-decoration: none;
                                    "
                                    target="_blank"
                                    >$email.getValue()</a
                                    >
                              </td>
                           </tr>
                           #end
                           #set($phone = $contact.getPrimaryPhone())
                           #if ($phone)
                           <tr
                              style="
                              font-family: Verdana, Geneva, Tahoma, sans-serif;
                              font-size: 14px;
                              font-weight: 400;
                              "
                              >
                              <td
                                 style="
                                 width: 130px;
                                 color: rgb(0, 0, 0, 0.6);
                                 align-content: baseline;
                                 padding-bottom: 12px;
                                 "
                                 >
                                 Phones:
                              </td>
                              <td style="padding-bottom: 12px">
                                 $phone.getNumber()
                              </td>
                           </tr>
                           #end
                           <tr
                              style="
                              font-family: Verdana, Geneva, Tahoma, sans-serif;
                              font-size: 14px;
                              font-weight: 400;
                              "
                              >
                              <td
                                 style="
                                 width: 130px;
                                 color: rgb(0, 0, 0, 0.6);
                                 align-content: baseline;
                                 padding-bottom: 12px;
                                 "
                                 >
                                 Created At :
                              </td>
                              <td style="padding-bottom: 12px">
                                 $dateTool.format("MMM d, yyyy", $webForm.getUpdatedTime())
                              </td>
                           </tr>
                           #set($submitAction = $webForm.getSubmitAction())
                           #set($thankYouMessage = $submitAction.getThankYouMessage())
                           #if ($thankYouMessage)
                           <tr
                              style="
                              font-family: Verdana, Geneva, Tahoma, sans-serif;
                              font-size: 14px;
                              font-weight: 400;
                              "
                              >
                              <td
                                 style="
                                 width: 130px;
                                 color: rgb(0, 0, 0, 0.6);
                                 align-content: baseline;
                                 padding-bottom: 12px;
                                 "
                                 >
                                 Your Message :
                              </td>
                              <td style="padding-bottom: 12px">
                                 $thankYouMessage
                              </td>
                           </tr>
                           #end
                        </table>
                     </div>
                  </div>
                  <div style="padding-top: 40px">
                     <p
                        style="
                        margin: 0px;
                        font-size: 14px;
                        font-weight: 400;
                        font-family: Verdana, Geneva, Tahoma, sans-serif;
                        "
                        >
                        Cheers,
                     </p>
                     <p
                        style="
                        margin: 0px;
                        font-size: 14px;
                        font-weight: 600;
                        font-family: Verdana, Geneva, Tahoma, sans-serif;
                        padding-top: 4px;
                        "
                        >
                        Team Twozo
                     </p>
                  </div>
               </div>
            </div>
            <div style="padding-top: 16px; text-align: center">
               <div style="text-align: center">
                  <div>
                     <img
                        width="72px"
                        height="22px"
                        style="margin-right: 12px"
                        src="https://ci3.googleusercontent.com/meips/ADKq_NaXM9lCOs5luvUcsKwYTE4a39T_j1ruuTAj8HA3Qy8qB1bdzlLyIO7AHV_2K__Ot03VQ3EH1vuUB1Mu4qt5BUWTutbWF1RsGsPe3yntKkeEGmn6iw=s0-d-e1-ft#https://ind-assets.freshsales.io/assets/images/google-play.png"
                        alt="google-play"
                        />
                     <img
                        width="72px"
                        height="22px"
                        style="margin-left: 12px"
                        src="https://ci3.googleusercontent.com/meips/ADKq_NYiX6-9q45vsuMEOkPWau7MEr-X5uNrY1gMEsfkpicybI2bRIGTjDMrYhP1Bb6j4v5dNNUwVTT-mPj1IC6Zw-0IN2YHoEVW5WJE2TyQJgp2vRQlQ9vHvok=s0-d-e1-ft#https://ind-assets.freshsales.io/assets/images/apple-app-store.png"
                        alt="apple-app-store"
                        />
                  </div>
                  <div style="padding-top: 8px">
                     <p
                        style="
                        margin: 0px;
                        font-size: 10px;
                        font-family: Verdana, Geneva, Tahoma, sans-serif;
                        color: rgba(0, 0, 0, 0.6);
                        "
                        >
                        Twozo Inc.
                     </p>
                  </div>
                  <div style="text-align: center; padding-top: 8px; opacity: 0.6">
                     <img
                        width="20px"
                        height="20px"
                        src="https://cdn4.iconfinder.com/data/icons/iconsimple-logotypes/512/facebook-64.png"
                        alt="facebook"
                        />
                     <img
                        width="20px"
                        height="20px"
                        style="margin: 0px 32px"
                        src="https://cdn3.iconfinder.com/data/icons/2018-social-media-logotypes/1000/2018_social_media_popular_app_logo_twitter-64.png"
                        alt="twitter"
                        />
                     <img
                        width="20px"
                        height="20px"
                        src="https://cdn2.iconfinder.com/data/icons/social-media-2102/100/social_media_circled_network-03-64.png"
                        alt="linkedIn"
                        />
                  </div>
               </div>
            </div>
         </div>
      </div>
   </body>
</html>