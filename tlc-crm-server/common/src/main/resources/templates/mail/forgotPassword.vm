<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title></title>
  </head>
  <body>

   #set($model = $template.get("model"))
    #set($forgotUserMessage = $model.getUrl())
 <div data-info-group="subject" style="display: none">Create a new password</div>
    <div style="margin: 0 auto; background: #fafafa; padding: 5% 10%">
      <div>
        <div
          style="
            background: white;
            border-radius: 8px;
            border: 1px rgba(0, 0, 0, 0.1) solid;
            overflow: auto;
            padding: 40px;
          "
        >
          <div>
            <img
              width="107px"
              height="33px"
              src="https://twozo.io/_next/image?url=%2Fimages%2Flogo%2Ftwozo-full-logo.png&w=256&q=75"
              alt="twozo"
            />
          </div>

          <div style="padding-top: 32px">
            <p
              style="
                margin: 0px;
                font-size: 18px;
                font-weight: 600;
                font-family: Verdana, Geneva, Tahoma, sans-serif;
              "
            >
              Create a New Password
            </p>

            <div style="padding-top: 9px">
              <p
                style="
                  margin: 0px;
                  font-size: 14px;
                  font-weight: 400;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  color: rgba(0, 0, 0, 0.6);
                "
              >
                Uh-oh! Forgot your password? No worries!
              </p>
              <p
                style="
                  margin: 0px;
                  font-size: 14px;
                  font-weight: 400;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  color: rgba(0, 0, 0, 0.6);
                "
              >
                Quickly reset it using the link below to secure your account.
              </p>
            </div>

            <div style="padding-top: 16px">
              <a
                href=$forgotUserMessage
                target="_blank"
                style="cursor: pointer"
              >
                <button
                  style="
                    font-size: 13px;
                    font-family: Verdana, Geneva, Tahoma, sans-serif;
                    font-weight: 600;
                    color: #fff;
                    background-color: #33bc7e;
                    border-radius: 8px;
                    padding: 8px 16px;
                    border: none;
                  "
                >
                  Create a new password
                </button>
              </a>
            </div>

            <div style="padding-top: 16px">
              <p
                style="
                  margin: 0px;
                  font-size: 14px;
                  font-weight: 400;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                "
              >
                Or
                <span
                  style="
                    font-weight: 500;
                    font-size: 14px;
                    font-family: Verdana, Geneva, Tahoma, sans-serif;
                    color: rgba(0, 0, 0, 0.6);
                  "
                  >copy this link into your browser to open Twozo:</span
                >
              </p>
            </div>

            <div style="padding-top: 16px">
              <a
                style="
                  font-size: 14px;
                  font-weight: 500;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  color: #33bc7e;
                  word-break: break-all;
                  cursor: pointer;
                "
                target="_blank"
                href=$forgotUserMessage
                >$forgotUserMessage</a
              >
            </div>

            <div style="padding-top: 16px">
              <span
                style="
                  font-weight: 400;
                  font-size: 14px;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  color: rgba(0, 0, 0, 0.6);
                "
                >This is part of the procedure to create a new password on the
                system. If you DID NOT request a new password then please ignore
                this email and your password will remain the same. If you're
                still having problems, feel free to contact us at
                <a
                  style="
                    font-size: 14px;
                    font-weight: 500;
                    font-family: Verdana, Geneva, Tahoma, sans-serif;
                    color: #33bc7e;
                    word-break: break-all;
                    cursor: pointer;
                  "
                  target="_blank"
                  href="support@twozo.io"
                  >support@twozo.io.</a
                ></span
              >
            </div>

            <div style="padding-top: 40px">
              <p
                style="
                  margin: 0px;
                  font-size: 14px;
                  font-weight: 400;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                "
              >
                Cheers,
              </p>
              <p
                style="
                  margin: 0px;
                  font-size: 14px;
                  font-weight: 600;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  padding-top: 4px;
                "
              >
                Team Twozo
              </p>
            </div>
          </div>
        </div>

        <div style="padding-top: 16px; text-align: center">
          <div style="text-align: center">
            <div>
              <img
                width="72px"
                height="22px"
                style="margin-right: 12px"
                src="https://ci3.googleusercontent.com/meips/ADKq_NaXM9lCOs5luvUcsKwYTE4a39T_j1ruuTAj8HA3Qy8qB1bdzlLyIO7AHV_2K__Ot03VQ3EH1vuUB1Mu4qt5BUWTutbWF1RsGsPe3yntKkeEGmn6iw=s0-d-e1-ft#https://ind-assets.freshsales.io/assets/images/google-play.png"
                alt="google-play"
              />

              <img
                width="72px"
                height="22px"
                style="margin-left: 12px"
                src="https://ci3.googleusercontent.com/meips/ADKq_NYiX6-9q45vsuMEOkPWau7MEr-X5uNrY1gMEsfkpicybI2bRIGTjDMrYhP1Bb6j4v5dNNUwVTT-mPj1IC6Zw-0IN2YHoEVW5WJE2TyQJgp2vRQlQ9vHvok=s0-d-e1-ft#https://ind-assets.freshsales.io/assets/images/apple-app-store.png"
                alt="apple-app-store"
              />
            </div>

            <div style="padding-top: 8px">
              <p
                style="
                  margin: 0px;
                  font-size: 10px;
                  font-family: Verdana, Geneva, Tahoma, sans-serif;
                  color: rgba(0, 0, 0, 0.6);
                "
              >
                Twozo Inc.
              </p>
            </div>

            <div style="text-align: center; padding-top: 8px; opacity: 0.6">
              <img
                width="20px"
                height="20px"
                src="https://cdn4.iconfinder.com/data/icons/iconsimple-logotypes/512/facebook-64.png"
                alt="facebook"
              />

              <img
                width="20px"
                height="20px"
                style="margin: 0px 32px"
                src="https://cdn3.iconfinder.com/data/icons/2018-social-media-logotypes/1000/2018_social_media_popular_app_logo_twitter-64.png"
                alt="twitter"
              />

              <img
                width="20px"
                height="20px"
                src="https://cdn2.iconfinder.com/data/icons/social-media-2102/100/social_media_circled_network-03-64.png"
                alt="linkedIn"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

