<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="UTF-8" />
   </head>
   <body style="margin: 0; background: #fafafa; font-family: Verdana, Geneva, Tahoma, sans-serif;">
      #set($model = $template.get("model"))
      #set($usersList = $template.getAll("users"))
      #set($isUsersListNotEmpty = $usersList && !$usersList.isEmpty())
      #if($isUsersListNotEmpty)
      #foreach($user in $usersList)
      #if($user.id().equals($model.getAdminUserId()))
      #set($adminUserEmail = $user.getEmail())
      #set($adminUserOrganization = $user.getOrganization().getName())
      #end
      #end
      #end
      <div data-info-group="subject" style="display:none;">Your account has been deactivated from $adminUserOrganization Twozo account</div>
      <div style="max-width: 600px; margin: 0 auto; padding: 60px 20px;">
      <div style="background: #ffffff; border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; padding: 40px;">
         <img
            src="https://twozo.io/_next/image?url=%2Fimages%2Flogo%2Ftwozo-full-logo.png&w=256&q=75"
            alt="Twozo"
            width="107"
            height="33"
            />
         <div style="padding-top: 25px;">
            <p style="margin: 0; font-size: 18px; font-weight: 700;">
               Hello $model.getCrmUser().getFullName(),
            </p>
            <p style="margin: 12px 0 0 0; font-size: 14px; color: rgba(0,0,0,0.6); line-height: 1.6;">
               Your Administrator <a href="mailto:$adminUserEmail" style="color: #0066cc; text-decoration: none;">$adminUserEmail</a>
               has deactivated you from the Twozo organization
               <strong>$adminUserOrganization</strong>.
               <br/>
               You will not be able to access this organization until your administrator reactivates your account.
            </p>
         </div>
         <div style="padding-top: 16px; text-align: center">
            <div style="text-align: center">
               <div>
                  <a href="https://play.google.com/store/apps/details?id=twozo.io.crm">
                  <img
                     width="72px"
                     height="22px"
                     style="margin-right: 12px"
                     src="https://ci3.googleusercontent.com/meips/ADKq_NaXM9lCOs5luvUcsKwYTE4a39T_j1ruuTAj8HA3Qy8qB1bdzlLyIO7AHV_2K__Ot03VQ3EH1vuUB1Mu4qt5BUWTutbWF1RsGsPe3yntKkeEGmn6iw=s0-d-e1-ft#https://ind-assets.freshsales.io/assets/images/google-play.png"
                     alt="google-play"
                     />
                  </a>
                  <img
                     width="72px"
                     height="22px"
                     style="margin-left: 12px"
                     src="https://ci3.googleusercontent.com/meips/ADKq_NYiX6-9q45vsuMEOkPWau7MEr-X5uNrY1gMEsfkpicybI2bRIGTjDMrYhP1Bb6j4v5dNNUwVTT-mPj1IC6Zw-0IN2YHoEVW5WJE2TyQJgp2vRQlQ9vHvok=s0-d-e1-ft#https://ind-assets.freshsales.io/assets/images/apple-app-store.png"
                     alt="apple-app-store"
                     />
               </div>
               <div style="padding-top: 8px">
                  <p
                     style="
                     margin: 0px;
                     font-size: 10px;
                     font-family: Verdana, Geneva, Tahoma, sans-serif;
                     color: rgba(0, 0, 0, 0.6);
                     "
                     >
                     Twozo Inc.
                  </p>
               </div>
               <div style="text-align: center; padding-top: 8px; opacity: 0.6">
                  <img
                     width="20px"
                     height="20px"
                     src="https://cdn4.iconfinder.com/data/icons/iconsimple-logotypes/512/facebook-64.png"
                     alt="facebook"
                     />
                  <img
                     width="20px"
                     height="20px"
                     style="margin: 0px 32px"
                     src="https://cdn3.iconfinder.com/data/icons/2018-social-media-logotypes/1000/2018_social_media_popular_app_logo_twitter-64.png"
                     alt="twitter"
                     />
                  <img
                     width="20px"
                     height="20px"
                     src="https://cdn2.iconfinder.com/data/icons/social-media-2102/100/social_media_circled_network-03-64.png"
                     alt="linkedIn"
                     />
               </div>
            </div>
         </div>
      </div>
   </body>
</html>