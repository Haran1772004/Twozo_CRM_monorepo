<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.tlc</groupId>
    <artifactId>social-starter</artifactId>
    <version>1.11.0-SNAPSHOT</version>
    <name>TLC Social Spring Starter</name>

    <properties>
        <tlc.components.starter.version>2.18.0-SNAPSHOT</tlc.components.starter.version>

        <tlc.social.client.version>1.7.0-SNAPSHOT</tlc.social.client.version>
        <tlc.social.server.version>1.11.0-SNAPSHOT</tlc.social.server.version>
        <tlc.social.common.version>1.11.0-SNAPSHOT</tlc.social.common.version>

        <tlc.sync.service.oauth.version>1.10.0-SNAPSHOT</tlc.sync.service.oauth.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>components-starter</artifactId>
            <version>${tlc.components.starter.version}</version>
        </dependency>

        <dependency>
            <groupId>com.tlc.social</groupId>
            <artifactId>social-server</artifactId>
            <version>${tlc.social.server.version}</version>
        </dependency>

        <dependency>
            <groupId>com.tlc.social</groupId>
            <artifactId>social-client</artifactId>
            <version>${tlc.social.client.version}</version>
        </dependency>

        <dependency>
            <groupId>com.tlc.social</groupId>
            <artifactId>social-common</artifactId>
            <version>${tlc.social.common.version}</version>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>sync-service-oauth</artifactId>
            <version>${tlc.sync.service.oauth.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>twozo-mvn-artifactory</id>
            <url>https://pkgs.dev.azure.com/twozo/TwozoCRM/_packaging/twozo-mvn-artifactory/maven/v1</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>tlc.commons.mvn.builder.release</id>
            <url>https://pkgs.dev.azure.com/twozo/TwozoCRM/_packaging/twozo-mvn-artifactory/maven/v1</url>
        </repository>
        <snapshotRepository>
            <id>tlc.commons.builder.snapshot</id>
            <url>https://pkgs.dev.azure.com/twozo/TwozoCRM/_packaging/twozo-mvn-artifactory/maven/v1</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.tlc.social.starter.SocialServiceLauncher</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.17.1</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                    <processAllModules>true</processAllModules>
                    <processDependencies>true</processDependencies>
                    <processParent>true</processParent>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
