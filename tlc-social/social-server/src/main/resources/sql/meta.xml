<?xml version="1.0" encoding="utf-8" ?>
<metadata>

    <module name="module_social">

        <table name="MSOChannel">
            <columns>
                <column name="ID" data-type="BIGINT"/>
                <column name="NAME" data-type="CHAR" nullable="false" max-length="300"/>
                <column name="TYPE" data-type="SMALLINT" nullable="false"/>
            </columns>
            <primary-key name="MSOChannel_PK" column="ID" sequence-generator="MSOChannel.ID"/>
            <!-- The name column contains fb page name. So different account can have same page name       -->
        </table>

        <table name="MSORecipientProfile">
            <columns>
                <column name="ID" data-type="BIGINT"/>
                <column name="NAME" data-type="CHAR" nullable="false" max-length="300"/>
                <column name="PROFILE_PIC_ID" data-type="BIGINT" nullable="true"/>
            </columns>
            <primary-key name="MSORecipientProfile_PK" column="ID" sequence-generator="MSORecipientProfile.ID"/>
            <unique-keys>
                <unique-key name="MSORecipientProfile_UK1">
                    <unique-key-column>PROFILE_PIC_ID</unique-key-column>
                </unique-key>
            </unique-keys>
        </table>

        <table name="MSOChat">
            <columns>
                <column name="ID" data-type="BIGINT"/>
                <column name="PLATFORM" data-type="SMALLINT" nullable="false"/>
                <column name="LAST_MESSAGE_TYPE" data-type="SMALLINT" nullable="false"/>
                <column name="LAST_MESSAGE_TIME" data-type="BIGINT" nullable="false"/>
                <column name="UNREAD_COUNT" data-type="INTEGER" nullable="false"/>
                <column name="PROFILE_ID" data-type="BIGINT" nullable="false"/>
                <column name="CHANNEL_ID" data-type="BIGINT" nullable="false"/>
            </columns>
            <primary-key name="MSOChat_PK" column="ID" sequence-generator="MSOChat.ID"/>
            <unique-keys>
                <unique-key name="MSOChat_UK1">
                    <unique-key-column>PROFILE_ID</unique-key-column>
                </unique-key>
            </unique-keys>
            <foreign-keys>
                <foreign-key name="MSOChat_FK1" reference-table="MSORecipientProfile"
                             local-column="PROFILE_ID" reference-column="ID" constraint="ON-DELETE-CASCADE"/>
                <foreign-key name="MSOChat_FK2" reference-table="MSOChannel"
                             local-column="CHANNEL_ID" reference-column="ID" constraint="ON-DELETE-CASCADE"/>
            </foreign-keys>
        </table>

        <table name="MSOMessage">
            <columns>
                <column name="ID" data-type="BIGINT"/>
                <column name="CHAT_ID" data-type="BIGINT" nullable="false"/>
                <column name="CONTENT" data-type="TEXT" nullable="true"/>
                <column name="MESSAGE_FLOW" data-type="SMALLINT" nullable="false"/>
                <column name="STATE" data-type="SMALLINT" nullable="false"/>
                <column name="SEND_TIME" data-type="BIGINT" nullable="false"/>
                <column name="DELIVERED_TIME" data-type="BIGINT" nullable="true"/>
                <column name="READ_TIME" data-type="BIGINT" nullable="true"/>
                <column name="FAILED_REASON" data-type="TEXT" nullable="true"/>
            </columns>
            <primary-key name="MSOMessage_PK" column="ID" sequence-generator="MSOMessage.ID"/>
            <foreign-keys>
                <foreign-key name="MSOMessage_FK1" reference-table="MSOChat"
                             local-column="CHAT_ID" reference-column="ID" constraint="ON-DELETE-CASCADE"/>
            </foreign-keys>
        </table>

        <table name="MSOAttachment">
            <columns>
                <column name="ID" data-type="BIGINT"/>
                <column name="MESSAGE_ID" data-type="BIGINT" nullable="false"/>
                <column name="ATTACHMENT_ID" data-type="BIGINT" nullable="false"/>
            </columns>
            <primary-key name="MSOAttachment_PK" column="ID" sequence-generator="MSOAttachment.ID"/>
            <unique-keys>
                <unique-key name="MSOAttachment_UK1">
                    <unique-key-column>MESSAGE_ID</unique-key-column>
                    <unique-key-column>ATTACHMENT_ID</unique-key-column>
                </unique-key>
            </unique-keys>
            <foreign-keys>
                <foreign-key name="MSOAttachment_FK1" reference-table="MSOMessage"
                             local-column="MESSAGE_ID" reference-column="ID" constraint="ON-DELETE-CASCADE"/>
            </foreign-keys>
        </table>

        <table name="MSORecipient">
            <columns>
                <column name="ID" data-type="BIGINT"/>
                <column name="CHAT_ID" data-type="BIGINT" nullable="false"/>
                <column name="PROFILE_ID" data-type="BIGINT" nullable="false"/>
            </columns>
            <primary-key name="MSORecipient_PK" column="ID" sequence-generator="MSORecipient.ID"/>
            <unique-keys>
                <unique-key name="MSORecipient_UK1">
                    <unique-key-column>CHAT_ID</unique-key-column>
                </unique-key>
                <unique-key name="MSORecipient_UK2">
                    <unique-key-column>PROFILE_ID</unique-key-column>
                </unique-key>
            </unique-keys>
            <foreign-keys>
                <foreign-key name="MSORecipient_FK" reference-table="MSOChat"
                             local-column="CHAT_ID" reference-column="ID" constraint="ON-DELETE-CASCADE"/>
                <foreign-key name="MSORecipient_FK2" reference-table="MSORecipientProfile"
                             local-column="PROFILE_ID" reference-column="ID" constraint="ON-DELETE-CASCADE"/>
            </foreign-keys>
        </table>

    </module>

