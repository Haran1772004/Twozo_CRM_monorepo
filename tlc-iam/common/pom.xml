<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tlc.iam</groupId>
        <artifactId>iam-core</artifactId>
        <version>2.30.0-SNAPSHOT</version>
    </parent>

    <groupId>com.tlc.iam</groupId>
    <artifactId>iam-common</artifactId>
    <version>2.21.0-SNAPSHOT</version>
    <name>IAM - Common</name>
    <packaging>bundle</packaging>

    <dependencies>
        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>commons</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>cache</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>i18n</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>sql-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>validator</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>attachment</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>webclient</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>l10n</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tlc</groupId>
            <artifactId>commons</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <private-package>com.tlc.iam.common.internal.*</private-package>
                        <Bundle-Activator>com.tlc.iam.common.CommonActivator</Bundle-Activator>
                        <Prerequisite-Bundles>com.tlc.i18n;</Prerequisite-Bundles>
                    </instructions>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.karaf.tooling</groupId>
                <artifactId>karaf-maven-plugin</artifactId>
                <configuration>
                    <enableGeneration>true</enableGeneration>
                    <primaryFeatureName>iam-common</primaryFeatureName>
                    <includeProjectArtifact>true</includeProjectArtifact>
                </configuration>
            </plugin>
        </plugins>

    </build>
</project>
